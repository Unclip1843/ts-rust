+/// Never retain this cache across checker mutation or worker ID-state changes.
+/// Collisions evict only optimization state and rerun the original comparison.
+pub(crate) struct ScopedTypeComparer<'a, const MEMO: bool> {
+    checker: &'a Checker,
+    memo: Vec<std::cell::Cell<TypeComparison>>,
+}
+
+#[derive(Clone, Copy, Default)]
+struct TypeComparison {
+    left: TypeId,
+    right: TypeId,
+    result: i32,
+}
+
+impl<'a> ScopedTypeComparer<'a, false> {
+    #[inline]
+    fn uncached(checker: &'a Checker) -> Self {
+        Self {
+            checker,
+            memo: Vec::new(),
+        }
+    }
