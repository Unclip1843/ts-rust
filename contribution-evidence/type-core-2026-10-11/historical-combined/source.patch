+impl<'a> ScopedTypeComparer<'a, true> {
+    pub(crate) fn memoized(checker: &'a Checker, work_items: usize) -> Self {
+        // 48 KiB, independent of the size of the compared type graph.
+        Self {
+            checker,
+            memo: if work_items >= 64 {
+                vec![std::cell::Cell::new(TypeComparison::default()); 4096]
+            } else {
+                Vec::new()
+            },
+        }
+    }
+}
